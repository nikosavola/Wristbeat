<?xml version="1.0" encoding="utf-8"?>
<!-- The app persists nothing: broadcasting state lives in memory and is deliberately not restored.
     Excluding every domain says that explicitly, and is what actually stops device-to-device
     transfer, which allowBackup="false" alone does not do on every device. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </device-transfer>
</data-extraction-rules>
