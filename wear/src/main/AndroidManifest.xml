<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- Bluetooth LE peripheral role: advertise the Heart Rate Service and serve its
         characteristics. BLUETOOTH_SCAN is not requested - the watch is the broadcaster, it never
         scans. Both are runtime permissions from API 31 on. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- No runtime Bluetooth permissions exist before API 31. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Reading the watch's own optical heart rate sensor, which is what gets broadcast. Android
         16 replaced BODY_SENSORS with the granular Health Connect permission of the same name for
         apps targeting API 36, so both are declared, each capped at the levels where it applies. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wristbeat">

        <!-- Standalone Wear OS listing: the app needs no phone companion. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="fi.nikosavola.wristbeat.main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- connectedDevice covers the BLE advertiser and GATT server. Reading the heart rate
             sensor alongside it does not need the "health" type: that type is what gates *starting*
             a service from the background for body sensors, and this one only ever starts from the
             button in the foreground. -->
        <service
            android:name=".HeartRateBroadcastService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- What an AI agent drives. The class named here is generated by the appfunctions compiler
             from BroadcastAppFunctions, which is where the functions themselves are declared: the
             generated subclass only carries the runtime plumbing, so this name does not appear in
             the source. Exported because the system binds it on an agent's behalf, and guarded by
             the platform permission that only a system agent can hold. -->
        <service
            android:name="fi.nikosavola.wristbeat.appfunctions.BroadcastAppFunctionsService"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            android:exported="true"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="broadcast_app_function_service.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>

        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_metadata" />

    </application>

</manifest>
